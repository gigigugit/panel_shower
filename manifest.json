{
  "manifest_version": 3,
  "name": "Panel Shower",
  "version": "0.1.0",
  "description": "Injects a compact draggable reference panel that mirrors Notes text from the current page.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
